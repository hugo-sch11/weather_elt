e, 0) \n            ORDER BY MAX(temperature_2m_max) DESC\n        ) AS rnk\n    FROM daily_global\n    WHERE temperature_2m_max >= 45 -- mandatory threshold to adjust (else OOM)\n    GROUP BY rlongitude, rlatitude, day\n)\n\nSELECT \n    rlongitude, \n    rlatitude, \n    day, \n    tmp_max, \n    rnk as rank\nFROM ranked_locations_by_temperature\nWHERE rnk <= 1 -- Top N hottest day PER LOCATION\nORDER BY rnk ASC, tmp_max DESC", "relation_name": "\"weather_analytics\".\"main\".\"mart_global_hottest_days\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-26T08:52:47.678842Z", "completed_at": "2026-08-26T08:52:47.696514Z"}, {"name": "execute", "started_at": "2026-08-26T08:52:47.698301Z", "completed_at": "2026-08-26T08:52:48.066323Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.3909296989440918, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.weather_analytics.not_null_stg_daily_regional_region.2002d8e4fd", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect region\nfrom \"weather_analytics\".\"main\".\"stg_daily_regional\"\nwhere region is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-26T08:52:47.214821Z", "completed_at": "2026-08-26T08:52:47.329982Z"}, {"name": "execute", "started_at": "2026-08-26T08:52:47.339068Z", "completed_at": "2026-08-26T08:52:48.128574Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.9185667037963867, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.weather_analytics.not_null_stg_daily_global_latitude.b2b34cec7e", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect latitude\nfrom \"weather_analytics\".\"main\".\"stg_daily_global\"\nwhere latitude is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": nul